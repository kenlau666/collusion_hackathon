# Copy these settings into the repository-root compute.env, which is gitignored.
# Use the exact base URL supplied by the endpoint owner, including /v1 if required.
MODAL_ENDPOINT_BASE_URL=
# Leave blank if unknown; we can try the endpoint's models listing first.
MODAL_ENDPOINT_MODEL=
# Bearer credential supplied by the owner. For a single Modal proxy credential,
# use the combined token ID + period + token secret, configured locally only.
MODAL_ENDPOINT_API_KEY=
# Optional separate proxy-auth headers if the deployment needs both proxy
# authentication and a different application-level bearer key.
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
